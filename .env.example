# Скопіюйте в .env і задайте свої значення (export $(grep -v '^#' .env | xargs))

# LLM (Ollama, OpenAI-compatible API)
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Tracing: phoenix | langsmith | both | none
TRACING_BACKEND=phoenix
PHOENIX_URL=http://127.0.0.1:6006
PHOENIX_PROJECT=acme-support-agent
DEPLOY_ENV=dev
PROMPT_VERSION=v1.1
# LangSmith (опційно, TRACING_BACKEND=langsmith|both)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=acme-support-agent

# SLA
PRICE_PROFILE=gpt-4.1-mini
RUN_BUDGET_USD=0.15
SOFT_BUDGET_RATIO=0.8
MAX_MODEL_CALLS=6
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT_S=30
# Slack → Apps → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# Guardrails
ALLOWED_DOMAINS=docs.acme.test,help.acme.test
